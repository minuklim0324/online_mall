<!--        INSERT INTO orders (order_id, product_id, qty, status, user_Id)-->
<!--        VALUES (#{orderId}, #{productId}, #{qty}, #{status}, 'user_01')-->
<!--    </insert>-->

    <insert id="insertOrder" parameterType="com.mall.order.dto.OrderRequest"
            useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO orders (product_id, qty, status, user_Id)
        VALUES (#{productId}, #{qty}, #{status}, 'user_01')
    </insert>

    <update id="updateStatus">
        UPDATE orders 
        SET status = #{status}
        WHERE order_id = #{orderId}
    </update>

</mapper>